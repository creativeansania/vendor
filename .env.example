# App Configuration
PORT=3000
NODE_ENV=development
SERVER_BASE_URL=https://api.kantiss.com

# Jubelio Configuration
JUBELIO_API_URL=https://api2.jubelio.com
JUBELIO_EMAIL=user@ansania.com
JUBELIO_PASSWORD=your_jubelio_password
JUBELIO_WEBHOOK_SECRET=your_webhook_secret_key_optional

# Odoo Configuration
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_db_name
ODOO_USERNAME=admin@ansania.com
ODOO_PASSWORD=your_odoo_password_or_api_key
ODOO_COMPANY_NAME=Ansania
ODOO_JENIS_SO="Penjualan Konsinyasi"
ODOO_WAREHOUSE_NAME="Gudang Online"

# Integration Settings
AUTO_CONFIRM_SO=true
AUTO_VALIDATE_DELIVERY=true
AUTO_CREATE_INVOICE=true
AUTO_POST_INVOICE=true
FALLBACK_CUSTOMER_NAME=Pelanggan Jubelio
DEFAULT_PRICELIST_ID=

# Marketplace Channel Customer Mapping (Odoo Generic Partners)
USE_CHANNEL_CUSTOMER=true
CHANNEL_CUSTOMER_SHOPEE="Shopee - Ansania"
CHANNEL_CUSTOMER_TOKOPEDIA="Tokopedia - Ansania"
CHANNEL_CUSTOMER_TIKTOK="TikTok Shop - Ansania"
CHANNEL_CUSTOMER_BLIBLI="Blibli - Ansania"
CHANNEL_CUSTOMER_LAZADA="Lazada - Ansania"
CHANNEL_CUSTOMER_EVERMOS="Evermos - Ansania"

# Wablas Configuration (WhatsApp Gateway)
WABLAS_BASE_URL=https://bdg.wablas.com
WABLAS_API_TOKEN=your_wablas_api_token
WABLAS_SECRET_KEY=your_wablas_secret_key_optional_if_whitelisted


# MySQL (PWA Vendor)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=5
