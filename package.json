{
  "name": "jubelio-odoo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Ansania - Jubelio Odoo Integration & Vendor PWA Monorepo",
  "main": "app.js",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node app.js",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "test:pwa": "npm --prefix backend run test:pwa",
    "migrate": "npm --prefix backend run migrate",
    "start:frontend": "npm --prefix frontend start",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build"
  },
  "keywords": [
    "ansania",
    "jubelio",
    "odoo",
    "pwa",
    "wip-vendor"
  ],
  "author": "",
  "license": "ISC"
}
